# Copiez ce fichier vers .env et remplissez-le. Le .env n'est jamais commité.

# Onglet "Bot" du portail développeur Discord, bouton "Reset Token".
DISCORD_TOKEN=

# Clic droit sur l'icône du serveur > Copier l'identifiant du serveur
# (il faut activer le mode développeur dans Paramètres > Avancés).
# Laisser vide fait une synchro globale des commandes, qui met jusqu'à 1 h.
DISCORD_GUILD_ID=

# Jeton GitHub à portée "repo" (classique) ou "Issues: read and write"
# (fine-grained) sur Maxyull/butin-bdo et Maxyull/rubin-bdo.
# Laisser vide désactive proprement le pont GitHub, le reste fonctionne.
GITHUB_TOKEN=

# Étiquettes ajoutées à chaque issue créée depuis Discord, séparées par des virgules.
GITHUB_DEFAULT_LABELS=discord

# Mettre à 1 pour tout faire sauf écrire sur GitHub (utile pour un premier essai).
DRY_RUN=0

LOG_LEVEL=INFO
